{
  "name": "cute-go",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node harness/run.mjs build",
    "preview": "vite preview",
    "test": "node harness/run.mjs test",
    "test:flows": "node harness/run.mjs test:flows",
    "lint": "node harness/run.mjs lint",
    "lint:fix": "npm run lint -- --fix",
    "lint:prune": "npm run lint -- --prune-suppressions",
    "check": "node harness/run.mjs check",
    "format": "prettier --write \"**/*.{ts,tsx,css}\" --ignore-path .gitignore",
    "typecheck": "node harness/run.mjs typecheck",
    "version:sync": "node update-version.js",
    "icon:gen": "capacitor-assets generate --android",
    "make-android": "npm run version:sync && npm run build && npm run icon:gen && npx cap sync android",
    "harness:sync": "node harness/contracts.mjs --write"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@sabaki/immutable-gametree": "^1.9.4",
    "@sabaki/sgf": "^3.4.7",
    "lucide-react": "^0.562.0",
    "onnxruntime-web": "1.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "esbuild": "0.25.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
