[Unit]
Description=Cute-Go Pi coach backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cute-go
Group=cute-go
WorkingDirectory=/opt/cute-go/current
ExecStart=/opt/cute-go/node/bin/node dist-server/main.mjs
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=COACH_HOST=127.0.0.1
Environment=COACH_PORT=80
Environment=COACH_ALLOWED_ORIGIN=https://yh7916.github.io
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
MemoryMax=384M
UMask=0077
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
